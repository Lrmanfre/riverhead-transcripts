    },
    {
      "start": 974.12,
      "end": 974.98,
      "text": "I vote no, because I did not get the resolution."
    },
    {
      "start": 974.98,
      "end": 977.58,
      "text": "And I will vote yes, so it's four to one."
    },
    {
      "start": 982.32,
      "end": 984.62,
      "text": "At this time, we'd like to ask for public comments"
    },
    {
