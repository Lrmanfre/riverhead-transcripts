      "text": "Resolution scheduled a public hearing"
    },
    {
      "start": 923.16,
      "end": 926.76,
      "text": "for a minor subdivision application seeking approval,"
    },
    {
      "start": 926.76,
      "end": 928.76,
      "text": "to accept and authorize circulation"
    },
    {
      "start": 928.76,
      "end": 931.76,
      "text": "to involved agencies on the draft environmental statement."
    },
    {
