      "end": 937.08,
      "text": "Yes."
    },
    {
      "start": 937.08,
      "end": 937.9,
      "text": "Member Hogan?"
    },
    {
      "start": 937.9,
      "end": 938.74,
      "text": "Yes."
    },
    {
      "start": 938.74,
      "end": 939.58,
      "text": "Member De Niro?"
    },
    {
      "start": 939.58,
      "end": 940.44,
      "text": "Aye."
    },
    {
      "start": 940.44,
      "end": 941.28,
      "text": "Member Behr?"
    },
    {
      "start": 941.28,
      "end": 942.1,
      "text": "Yes."
    },
    {
      "start": 942.1,
