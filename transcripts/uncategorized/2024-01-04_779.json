    },
    {
      "start": 943.78,
      "end": 947.98,
      "text": "I move resolution number 2024-005,"
    },
    {
      "start": 947.98,
      "end": 950.52,
      "text": "for the Calvington Industrial Subdivision,"
    },
    {
      "start": 950.52,
