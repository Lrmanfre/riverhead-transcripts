<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.riverhead.transcripts</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/lawrencemanfredi/Documents/1 Projects/riverhead-transcripts/run_pipeline.sh</string>
    </array>

    <!-- Fire at 1:00 AM every day -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>1</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- If the Mac was asleep at 1am, run as soon as it wakes -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/lawrencemanfredi/Library/Logs/riverhead/launchd_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/lawrencemanfredi/Library/Logs/riverhead/launchd_stderr.log</string>
</dict>
</plist>
